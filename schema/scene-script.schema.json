{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fable.local/schema/scene-script.json",
  "title": "Fable SceneScript",
  "description": "Validated instructions the interpreter emits and Unity executes. Every asset, animation, light and sound id must come from the scene's manifest vocabulary; Unity rejects anything else.",
  "type": "object",
  "required": ["version", "sceneId", "environment", "beats"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "sceneId": { "type": "string", "enum": ["hall-of-doors", "mad-tea-party", "queens-croquet-ground"] },
    "title": { "type": "string", "maxLength": 80 },
    "environment": {
      "type": "object",
      "required": ["prefab", "ambience"],
      "additionalProperties": false,
      "properties": {
        "prefab": { "type": "string", "description": "Environment prefab id from the manifest, e.g. env.hall-of-doors" },
        "ambience": { "type": "string", "description": "Looping spatial ambience id, e.g. amb.hall-lamps" },
        "exposure": { "type": "number", "minimum": -2, "maximum": 2, "default": 0 },
        "fog": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.15 }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "One beat per sentence, in reading order. Unity advances one beat per hand gesture.",
      "items": {
        "type": "object",
        "required": ["sentenceId", "actions"],
        "additionalProperties": false,
        "properties": {
          "sentenceId": { "type": "string", "pattern": "^[a-z-]+:[0-9]{3}$" },
          "focus": { "type": "string", "description": "Optional anchor id the reader's gaze cue points at" },
          "actions": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "oneOf": [
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "asset", "anchor"],
                  "properties": {
                    "type": { "const": "place" },
                    "asset": { "type": "string" },
                    "anchor": { "type": "string" },
                    "offset": { "$ref": "#/$defs/vec3" },
                    "yawDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
                    "scale": { "type": "number", "minimum": 0.05, "maximum": 20 },
                    "appear": { "type": "string", "enum": ["instant", "fade", "grow", "settle"], "default": "fade" }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "asset"],
                  "properties": {
                    "type": { "const": "remove" },
                    "asset": { "type": "string" },
                    "vanish": { "type": "string", "enum": ["instant", "fade", "shrink"], "default": "fade" }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "target", "clip"],
                  "properties": {
                    "type": { "const": "animate" },
                    "target": { "type": "string" },
                    "clip": { "type": "string", "description": "Supported clip id for that target, e.g. door.open, lamp.flicker, bottle.uncork" },
                    "durationSeconds": { "type": "number", "minimum": 0.1, "maximum": 20 },
                    "loop": { "type": "boolean", "default": false }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "light"],
                  "properties": {
                    "type": { "const": "light" },
                    "light": { "type": "string" },
                    "intensity": { "type": "number", "minimum": 0, "maximum": 4 },
                    "kelvin": { "type": "integer", "minimum": 1500, "maximum": 8000 },
                    "durationSeconds": { "type": "number", "minimum": 0, "maximum": 20 }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "sound"],
                  "properties": {
                    "type": { "const": "sound" },
                    "sound": { "type": "string" },
                    "anchor": { "type": "string" },
                    "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "anchor"],
                  "properties": {
                    "type": { "const": "readerScale" },
                    "anchor": { "type": "string", "description": "Where the reader stands" },
                    "scale": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "World scale relative to the reader: 1 = Alice-sized adult, 4 = shrunk to ten inches" },
                    "durationSeconds": { "type": "number", "minimum": 0.5, "maximum": 12 }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number", "minimum": -20, "maximum": 20 }, "minItems": 3, "maxItems": 3 }
  }
}
