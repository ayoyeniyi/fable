# Fable's preparation service on the VM (docs/BACKEND.md). Installed by deploy/deploy.sh.
[Unit]
Description=Fable preparation service
After=network-online.target
Wants=network-online.target

[Service]
User=fable
Group=fable
WorkingDirectory=/opt/fable
EnvironmentFile=/etc/fable/env
EnvironmentFile=/etc/fable/sandbox
EnvironmentFile=-/etc/fable/limits
Environment=FABLE_ROOT=/opt/fable
Environment=HOME=/var/lib/fable
Environment=FABLE_THUMB_ENGINE=CYCLES
Environment=FABLE_CYCLES_DEVICE=CPU
Environment=DAILY_CLAUDE_CALLS=1500
Environment=BOOKS_PER_CLIENT=2
ExecStart=/opt/fable/bin/fable-interpreter serve --addr 127.0.0.1:8787 --wait 20s --public $FABLE_SANDBOX \
  --daily-claude-calls ${DAILY_CLAUDE_CALLS} --rooms-books-per-client ${BOOKS_PER_CLIENT} --blender /opt/blender/blender
Restart=always
RestartSec=5
# hardening: read-only system, writes only to the service's own data
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/fable/out /var/lib/fable
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
